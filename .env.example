OPENAI_API_KEY=PASTE_YOUR_KEY_HERE
OPENAI_BASE_URL=https://api.shopaikey.com/v1
APP_ACCESS_CODE=CHANGE_ME

# Quota / statistics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_DOCUMENT_LIMIT=30
USAGE_TIME_ZONE=Asia/Bangkok
USAGE_KEY_PREFIX=soat-van-ban-ai:v0.9.9
REVIEW_RESERVATION_TTL_SECONDS=10800
REVIEW_REQUESTS_PER_MINUTE=120

# Cost/quality routing
# Local review: keep Mini for all normal work to protect wording/grammar quality.
OPENAI_LOCAL_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_LOCAL_FALLBACK_MODEL=gpt-5.4-mini-2026-03-17

# Global review: Mini for normal documents; Sol only for high-risk profiles.
OPENAI_DEEP_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_HIGH_RISK_MODEL=gpt-5.6-sol
AI_GLOBAL_HIGH_RISK_PROFILES=contract,academic
OPENAI_DEEP_FALLBACK_MODEL=gpt-5.4-mini-2026-03-17

# Lower concurrency reduces burst rate, 429/524 retries and wasted partial generations.
NEXT_PUBLIC_AI_CONCURRENCY=2
AI_LOCAL_FIRST_BYTE_TIMEOUT_MS=80000
AI_DEEP_FIRST_BYTE_TIMEOUT_MS=115000
AI_STREAM_IDLE_TIMEOUT_MS=45000
AI_LOCAL_MAX_TOKENS=2600
AI_DEEP_MAX_TOKENS=3200

# AI stability tuning (ShopAIKey/OpenAI-compatible)
OPENAI_LOCAL_MODEL=gpt-5.2
OPENAI_LOCAL_FALLBACK_MODEL=gpt-5.2
OPENAI_DEEP_MODEL=gpt-5.2
OPENAI_DEEP_FALLBACK_MODEL=gpt-5.2
OPENAI_HIGH_RISK_MODEL=gpt-5.2
AI_LOCAL_MAX_TOKENS=1800
AI_DEEP_MAX_TOKENS=2200
AI_LOCAL_FIRST_BYTE_TIMEOUT_MS=60000
AI_DEEP_FIRST_BYTE_TIMEOUT_MS=90000
AI_STREAM_IDLE_TIMEOUT_MS=30000
